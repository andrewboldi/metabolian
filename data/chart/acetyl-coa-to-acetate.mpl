# Ingested from Rhea. The spine follows the carbon skeleton from
# acetyl-CoA to acetate; everything entering or leaving at the
# side is a cofactor on that step. Generated by tools/ingest/build-modules.mjs —
# edit the generator, not this file.

pathway acetyl-coa-to-acetate "acetyl-CoA to acetate" {
  spacing 152

  spine at 0,0 {
    acetyl_coa
    <-> . +3_15_diacetylnivalenol -coa
    3_4_15_triacetylnivalenol
    <-> . +h2o -h -acetate
    4_15_diacetylnivalenol
    <-> . +h2o -h -acetate
    4_acetylnivalenol
  }
}
