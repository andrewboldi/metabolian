# PMF to H2O; everything entering or leaving at the
# side is a cofactor on that step. Generated by tools/ingest/build-modules.mjs —
# edit the generator, not this file.

pathway pmf-to-h2o "PMF to H2O" {
  spacing 152

  spine at 0,0 {
    pmf
    <-> . +nitrite +ubiquinone_8 +h2o -pmf -nitrate
