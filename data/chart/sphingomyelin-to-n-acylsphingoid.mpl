# sphingomyelin to N-acylsphingoid; everything entering or leaving at the
# side is a cofactor on that step. Generated by tools/ingest/build-modules.mjs —
# edit the generator, not this file.

pathway sphingomyelin-to-n-acylsphingoid "sphingomyelin to N-acylsphingoid" {
