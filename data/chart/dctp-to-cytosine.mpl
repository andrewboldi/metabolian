# Ingested from Rhea. The spine follows the carbon skeleton from
# dCTP(4−) to cytosine; everything entering or leaving at the
# side is a cofactor on that step. Generated by tools/ingest/build-modules.mjs —
# edit the generator, not this file.

pathway dctp-to-cytosine "dCTP to cytosine" {
  spacing 200

  spine at 0,0 {
    dctp
    <-> . +pyruvate -phosphonatoenolpyruvate -hplus
    dcdp
    <-> . +h2o -pi -hplus
    2_deoxycytosine_5_monophosphate
    <-> . +h2o -pi
    2_deoxycytidine
    <-> ec_2_4_2_6 [2.4.2.6] +adenine -cytosine
    2_deoxyadenosine
  }
}
