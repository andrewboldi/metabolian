/target

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Node / web build
node_modules/
dist/
web/public/graph/
*.tsbuildinfo
.DS_Store
npm-debug.log*

# Ingest source tables — large, reproducible via tools/ingest/fetch.sh.
# Everything DERIVED from them (modules, layouts, sheets.json) is committed.
data/ingest/*.tsv
data/ingest/*.dat

# Molecule SVGs — derived from data/smiles.json by `npm run mol:build` (RDKit).
# Committing ~1,143 was fine, but full ChEBI coverage (~12k structures) is ~240 MB,
# too large for git. Baked at BUILD TIME instead: predev/prebuild run mol:build
# before data:build, and @rdkit/rdkit is a dependency so CI/Pages renders them.
# (Size exception to the "derived is committed" rule above.)
web/public/mol/
